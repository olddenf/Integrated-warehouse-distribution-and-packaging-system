# 测试环境配置文件

# 数据库配置（使用SQLite用于测试）
DATABASE_URL=sqlite+aiosqlite:///./test_saas_warehouse.db

# Redis配置（测试环境可以跳过）
REDIS_URL=redis://localhost:6379/1

# JWT配置
JWT_SECRET_KEY=test-secret-key-for-testing-only
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=120

# 高德地图配置（测试环境使用Mock）
AMAP_API_KEY=test-amap-api-key

# 阿里云OSS配置（测试环境使用Mock）
OSS_ACCESS_KEY_ID=test-access-key-id
OSS_ACCESS_KEY_SECRET=test-access-key-secret
OSS_BUCKET_NAME=test-bucket-name
OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com

# Celery配置
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# 加密密钥
ENCRYPTION_KEY=test-encryption-key-for-testing-only

# 日志级别
LOG_LEVEL=DEBUG

# 项目信息
PROJECT_NAME=SaaS仓配装一体化管理系统
VERSION=1.0.0
